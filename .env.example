# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/car_rental_dev
DATABASE_POOL_SIZE=20
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000
APP_NAME=TrustFirst Car Rental

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=car-rental-images-dev

# OpenAI
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@trustfirst.com

# Pricing
BASE_PRICE_PER_HOUR=25
WEEKEND_MULTIPLIER=1.5
PEAK_HOURS_MULTIPLIER=1.3

# Feature Flags
FEATURE_OFFLINE_SYNC=true
FEATURE_AI_ASSISTANT=true
FEATURE_DYNAMIC_PRICING=true
FEATURE_KYC=true

# Image Processing
IMAGE_MAX_SIZE_MB=5
IMAGE_QUALITY=80
